          "series": "fixture_requests_total{service=\"demo\",result=\"bad\"}",
          "values": "0 10 20 30 40 50 50 50 50 50 50 50 50"
        }
      ],
      "alert_rule_test": [
        {
          "alertname": "FixtureSymptom",
          "eval_time": "2m",
          "exp_alerts": []
        },
        {
          "alertname": "FixtureSymptom",
          "eval_time": "4m",
          "exp_alerts": [
            {
              "exp_labels": {
                "service": "demo",

      "connections": {
        "used": 50,
        "usable_limit": 50
      },
      "pool": {
        "active": 10,
        "limit": 10,
        "queued": 8
      },
      "archiver": {
        "reset_epoch": "same",
        "before": {
          "archived_count": 10,
          "failed_count": 0
        },
        "after": {
          "archived_count": 11,
          "failed_count": 0
        }
      },
      "slots": [
        {
          "active": true,
          "retained_bytes": 10,
          "capacity_budget_bytes": 100,
          "progressed": true
        }
      ],
      "mitigation_succeeds": true,
      "user_path_recovers": true
    },
    "expected_steps": [
      "observe",
      "provider",
      "locks",
      "lock_change",
      "verify"
    ],
    "terminal": "recovered"
  },
